# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"
DATABASE_PRISMA_DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Admin Authentication & Session Security
ADMIN_USERNAME="tpfadmin"
ADMIN_PASSWORD="YourStrongSecretAdminPassword123!"
# Generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET="your-32-byte-hex-random-secret-key-here"

# UploadThing (File Upload Infrastructure)
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# Resend (Recruitment Email Service)
RESEND_API_KEY="re_your_resend_api_key_here"

# YouTube Data API v3 (Optional for live channel sync)
YOUTUBE_API_KEY="your_youtube_api_key_here"
